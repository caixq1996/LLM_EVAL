#!/bin/bash
#$ -S /bin/bash
#$ -cwd
#$ -j y
#$ -jc gtn-container_g8.24h
#$ -ac d=nvcr-cuda-12.4.1-ubuntu22.04,d_shm=64g

set -x

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
EVAL_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
cd "${EVAL_ROOT}"

export PYTHONUNBUFFERED=1

PYTHON_BIN="${PYTHON_BIN:-$HOME/miniconda3/envs/eval/bin/python3}"

# Defaults mirror examples/batch_curl_v6.sh
CKPT_DIR="${CKPT_DIR:-/data/giil/caixq/ckpts}"
TRAIN_DATA="${TRAIN_DATA:-deepscaler_diff}"
USE_CURL="${USE_CURL:-true}"  # true | false | both

# Comma-separated lists (override as needed)
MODELS="${MODELS:-meta-llama/Llama-3.2-3B-Instruct,deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B,Qwen/Qwen2.5-math-1.5B,Qwen/Qwen2.5-math-7B}"
EXPS="${EXPS:-vf_majority_vote,vf_selfcert_logp,vf_entropy,ver_rule_grpo}"

OUT_DIR="${OUT_DIR:-${EVAL_ROOT}/eval_log/vi_curl/curriculum}"
TAG="${TAG:-}"
SMOOTH_WEIGHT="${SMOOTH_WEIGHT:-0.8}"
DPI="${DPI:-200}"
USE_EMA="${USE_EMA:-false}"

args=(
  --ckpt_dir "${CKPT_DIR}"
  --train_data "${TRAIN_DATA}"
  --use_curl "${USE_CURL}"
  --models "${MODELS}"
  --exps "${EXPS}"
  --out_dir "${OUT_DIR}"
  --smooth_weight "${SMOOTH_WEIGHT}"
  --dpi "${DPI}"
)
if [[ -n "${TAG}" ]]; then
  args+=( --tag "${TAG}" )
fi
if [[ "${USE_EMA}" != "true" ]]; then
  args+=( --no_ema )
fi

"${PYTHON_BIN}" -u tools/vi_curl_plot/plot_vi_curl_curriculum_effects.py "${args[@]}"

echo "[OK] Curriculum plots saved under: ${OUT_DIR}"
