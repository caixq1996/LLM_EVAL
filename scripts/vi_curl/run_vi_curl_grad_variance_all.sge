#!/bin/bash
#$ -S /bin/bash
#$ -cwd
#$ -jc gtn-container_g8.24h
#$ -ac d=nvcr-cuda-12.4.1-ubuntu22.04,d_shm=256g
#$ -j y

set -x

# -------------------------------------------------------
# VI-CuRL grad-variance sweep runner (SGE)
#
# Modes:
#   1) MODEL_ROOT points to a ckpt root containing many runs:
#        /data/giil/caixq/ckpts/VI-CURL_deepscaler/<run_name>/global_step_*
#      -> run for all runs under MODEL_ROOT
#
#   2) MODEL_ROOT points to a specific run dir:
#        /data/giil/caixq/ckpts/VI-CURL_deepscaler/<run_name>
#      -> run only this run (all steps unless STEPS specified)
#
# Prompt config is kept consistent with run_qwen_eval_all.sge naming:
#   PROMPT_TYPE, MAX_TOKENS (mapped to --max_new_tokens)
# -------------------------------------------------------
#
# Usage (replot only):
#   bash scripts/vi_curl/run_vi_curl_grad_variance_all.sge --replot-only

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
EVAL_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
cd "${EVAL_ROOT}"

export PYTHONUNBUFFERED=1
export TORCH_CPP_LOG_LEVEL=ERROR

# Detect GPU count (same logic as run_qwen_eval_all.sge)
if [[ -z "${NUM_GPUS:-}" ]]; then
  if command -v nvidia-smi >/dev/null 2>&1; then
    NUM_GPUS=$(nvidia-smi --list-gpus | grep -c '^GPU')
    [[ "${NUM_GPUS}" -ge 1 ]] || NUM_GPUS=1
  else
    NUM_GPUS=1
  fi
fi

PYTHON_BIN="${PYTHON_BIN:-$HOME/miniconda3/envs/eval/bin/python3}"

# Root or single run
MODEL_ROOT="${MODEL_ROOT:-/data/giil/caixq/ckpts/VI-CURL_deepscaler_diff/vf_majority_vote_curl_Qwen2.5-math-1.5B}"

# Prompt file/config (defaults to deepscaler train prompts)
PROMPT_FILE="${PROMPT_FILE:-${EVAL_ROOT}/data/deepscaler/train.jsonl}"
PROMPT_FIELD="${PROMPT_FIELD:-problem}"
PROMPT_TYPE="${PROMPT_TYPE:-think-boxed}"
COMPUTE_PASSK="${COMPUTE_PASSK:-false}"
DATA_NAME="${DATA_NAME:-deepscaler}"
ANSWER_FIELD="${ANSWER_FIELD:-answer}"
PASSK_KS="${PASSK_KS:-1,8}"

# Prompt filtering + rollout + projection
MAX_PROMPT_LEN="${MAX_PROMPT_LEN:-512}"
NUM_PROMPTS="${NUM_PROMPTS:-0}"
NUM_PROMPT_RATIO="${NUM_PROMPT_RATIO:-0.01}"
SUBSET_MODE="${SUBSET_MODE:-random}"
SEED="${SEED:-42}"
K_ROLLOUTS="${K_ROLLOUTS:-8}"
MAX_RESPONSE_LEN="${MAX_RESPONSE_LEN:-3072}"
MAX_TOKENS="${MAX_TOKENS:-${MAX_RESPONSE_LEN}}"     # mapped to --max_new_tokens
TEMPERATURE="${TEMPERATURE:-0.6}"
TOP_P="${TOP_P:-0.95}"
GEN_BATCH_SIZE="${GEN_BATCH_SIZE:-512}"
SAMPLING_MODE="${SAMPLING_MODE:-topk}"   # topk | full
PROB_MODE="${PROB_MODE:-full}"           # topk | full (use full for better neg_entropy/τ alignment)

# Speed knobs
SHARD_LOAD_WORKERS="${SHARD_LOAD_WORKERS:-4}"
EMPTY_CACHE_EACH_BATCH="${EMPTY_CACHE_EACH_BATCH:-false}"
INFERENCE_MODE="${INFERENCE_MODE:-true}"
ENABLE_TF32="${ENABLE_TF32:-true}"

# Optional vLLM backend (usually faster, but requires HF weights; can export on the fly)
# Default is true (vf_curl_grad_variance.py also defaults to vLLM).
USE_VLLM="${USE_VLLM:-true}"
WORK_HOME_BASE="${WORK_HOME:-/data/giil/caixq}"
KEEP_HF_EXPORT="${KEEP_HF_EXPORT:-false}"
if [[ -z "${HF_EXPORT_ROOT:-}" ]]; then
  if [[ "${KEEP_HF_EXPORT}" == "true" ]]; then
    HF_EXPORT_ROOT="${WORK_HOME_BASE}/export"
  else
    if [[ -d /dev/shm ]] && [[ -w /dev/shm ]]; then
      HF_EXPORT_ROOT="/dev/shm/vi_curl_passk_export"
    else
      HF_EXPORT_ROOT="${WORK_HOME_BASE}/export"
    fi
  fi
fi
BASE_MODEL_DIR="${BASE_MODEL_DIR:-}"
EXPORT_HF_IF_NEEDED="${EXPORT_HF_IF_NEEDED:-true}"
VLLM_TP="${VLLM_TP:-1}"
VLLM_PP="${VLLM_PP:-1}"
VLLM_GPU_MEM_UTIL="${VLLM_GPU_MEM_UTIL:-0.90}"
VLLM_MAX_NUM_SEQS="${VLLM_MAX_NUM_SEQS:-0}"

PROJ_DIM="${PROJ_DIM:-256}"
ENTROPY_TOPK="${ENTROPY_TOPK:-32}"
TOPK="${TOPK:-${ENTROPY_TOPK}}"
# Match VI-CURL training defaults (examples/curl_v6.sh): CONFIDENCE_METRIC=neg_entropy unless overridden.
CONF_METRIC="${CONF_METRIC:-neg_entropy}"  # avg_logp | neg_entropy

# Tokenizer (for prompt length filter)
TOKENIZER_DIR="${TOKENIZER_DIR:-}"

# Curriculum schedule (match your training config; override when needed)
START_BETA="${START_BETA:-0.2}"
END_BETA="${END_BETA:-1.0}"
SCHEDULE_STEPS="${SCHEDULE_STEPS:-313}"
# beta_target mapping:
# - train: use training-faithful schedule (step/schedule_steps) [match curl_v6.sh]
# - rescaled: map first/last reference checkpoints to start_beta/end_beta and
#             space intermediate checkpoints uniformly by checkpoint index.
BETA_SCHEDULE_MODE="${BETA_SCHEDULE_MODE:-rescaled}"   # train | rescaled
BETA_REF_STEPS="${BETA_REF_STEPS:-20-313:20}"          # optional, same format as STEPS / step csv
BETA_SOURCE="${BETA_SOURCE:-log}"                      # compute | log
BETA_LOG_PATH="${BETA_LOG_PATH:-}"                     # optional wandb output.log path
BETA_LOG_ROOT="${BETA_LOG_ROOT:-${EVAL_ROOT}/../VI-CURL/wandb}"
USE_LOG_TAU="${USE_LOG_TAU:-true}"

# Optional step subset: e.g. "20-313:20" or "20,40,60"
STEPS="${STEPS:-}"

# Optional: batch gradient ||g|| variance across seeds
BATCH_VAR_SEEDS="${BATCH_VAR_SEEDS:-}"         # e.g. "0,1,2,3"
BATCH_VAR_NUM_PROMPTS="${BATCH_VAR_NUM_PROMPTS:-128}"
BATCH_VAR_K="${BATCH_VAR_K:-1}"
PLOT_BASELINE_FULL_ONLY="${PLOT_BASELINE_FULL_ONLY:-false}"

# Output dir for json/pdf (script caches by config hash)
OUT_DIR="${OUT_DIR:-${EVAL_ROOT}/eval_log/vi_curl/grad_variance}"
LOG_DIR="${LOG_DIR:-${EVAL_ROOT}/eval_log/vi_curl/grad_variance_logs}"

# Baseline pairing:
#   auto: if run name contains "_curl_", use sibling "_nocurl_" run if exists
#   none: don't pass --baseline_run_dir
BASELINE_MODE="${BASELINE_MODE:-auto}"   # auto | none

# Merge/plot integration (for step-sharded runs producing __part*.json)
# - merge_vf_curl_grad_variance_parts.py both merges AND renders the merged plot.
AUTO_MERGE_PARTS="${AUTO_MERGE_PARTS:-true}"
MERGE_DELETE_PARTS="${MERGE_DELETE_PARTS:-false}"
MERGE_ONLY="${MERGE_ONLY:-false}"   # if true, just scan OUT_DIR and merge any complete part sets
REPLOT_ONLY="${REPLOT_ONLY:-false}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --replot-only)
      REPLOT_ONLY="true"
      shift
      ;;
    --merge-only)
      MERGE_ONLY="true"
      shift
      ;;
    *)
      shift
      ;;
  esac
done

mkdir -p "${EVAL_ROOT}/eval_log"
mkdir -p "${OUT_DIR}"
mkdir -p "${LOG_DIR}"

TS="$(date +%Y%m%d_%H%M%S)"
echo "[INFO] Job started at ${TS}. Detected ${NUM_GPUS} GPUs."
echo "[INFO] MODEL_ROOT=${MODEL_ROOT}"
echo "[INFO] PROMPT_FILE=${PROMPT_FILE} (field=${PROMPT_FIELD}, type=${PROMPT_TYPE})"
if [[ -n "${STEPS}" ]]; then
  echo "[INFO] STEPS filter=${STEPS}"
else
  echo "[INFO] STEPS filter=<none> (use all available steps)"
fi

maybe_suffix_tag_for_beta_mode() {
  # Ensure different beta_schedule_mode runs never overwrite the same tag-named outputs.
  if [[ -n "${TAG:-}" ]] && [[ "${BETA_SCHEDULE_MODE}" != "train" ]]; then
    case "${TAG}" in
      *__${BETA_SCHEDULE_MODE}) ;;
      *) TAG="${TAG}__${BETA_SCHEDULE_MODE}" ;;
    esac
  fi
}

# If user pre-sets TAG=..., make it mode-specific (only for non-train modes).
maybe_suffix_tag_for_beta_mode

merge_one_parts() {
  local run_name="$1"
  local tag="$2"
  local num_parts="$3"

  # Skip merge unless all expected part json files exist.
  local missing=0
  for ((i=0; i<num_parts; i++)); do
    local p="${OUT_DIR}/vf_curl_grad_variance__${run_name}__${tag}__part${i}.json"
    if [[ ! -f "${p}" ]]; then
      if (( missing == 0 )); then
        echo "[WARN] Missing part json(s); skip merge for now:"
      fi
      echo "[WARN]   ${p}"
      missing=$((missing + 1))
    fi
  done
  if (( missing > 0 )); then
    return 0
  fi

  local args=( --out_dir "${OUT_DIR}" --run_name "${run_name}" --tag "${tag}" --num_parts "${num_parts}" )
  if [[ "${MERGE_DELETE_PARTS}" == "true" ]]; then
    args+=( --delete_parts )
  fi
  if [[ "${PLOT_BASELINE_FULL_ONLY}" == "true" ]]; then
    args+=( --plot_baseline_full_only )
  fi

  echo "[INFO] Merging parts: run=${run_name} tag=${tag} num_parts=${num_parts}"
  "$PYTHON_BIN" -u "${EVAL_ROOT}/tools/merge_vf_curl_grad_variance_parts.py" "${args[@]}"
}

auto_merge_parts_in_out_dir() {
  if [[ "${AUTO_MERGE_PARTS}" != "true" ]]; then
    return 0
  fi

  # Emit "run_name<TAB>tag<TAB>num_parts" for each complete part set without merged output yet.
  while IFS=$'\t' read -r run_name tag num_parts; do
    [[ -z "${run_name}" || -z "${tag}" || -z "${num_parts}" ]] && continue
    merge_one_parts "${run_name}" "${tag}" "${num_parts}"
  done < <(
    "$PYTHON_BIN" - "${OUT_DIR}" <<'PY'
import re
import sys
import json
import os
from pathlib import Path

out_dir = Path(sys.argv[1]).expanduser()
if not out_dir.exists():
    sys.exit(0)

pat = re.compile(r"^vf_curl_grad_variance__(?P<run>.+?)__(?P<tag>.+?)__part(?P<part>\d+)\.json$")

groups: dict[tuple[str, str], dict[str, object]] = {}
for p in out_dir.glob("vf_curl_grad_variance__*__*__part*.json"):
    m = pat.match(p.name)
    if not m:
        continue
    run = m.group("run")
    tag = m.group("tag")
    part = int(m.group("part"))

    exp = None
    try:
        payload = json.loads(p.read_text(encoding="utf-8"))
        exp = int(payload.get("num_parts") or 0) or None
    except Exception:
        exp = None

    g = groups.setdefault((run, tag), {"parts": set(), "expected": 0})
    g["parts"].add(part)  # type: ignore[union-attr]
    if exp is not None and exp > int(g["expected"]):  # type: ignore[arg-type]
        g["expected"] = exp

for (run, tag), g in sorted(groups.items()):
    parts = g["parts"]
    expected = int(g["expected"]) or 0
    if not parts:  # type: ignore[truthy-bool]
        continue

    max_part = max(parts)  # type: ignore[arg-type]
    if expected <= 0:
        expected = max_part + 1
    if expected < max_part + 1:
        expected = max_part + 1

    want = set(range(0, expected))
    if set(parts) != want:  # type: ignore[arg-type]
        continue
    merged_json = out_dir / f"vf_curl_grad_variance__{run}__{tag}.json"
    full_only = os.getenv("PLOT_BASELINE_FULL_ONLY", "false").lower() == "true"
    suffix = "sigma_vprob" if full_only else "sigma"
    merged_pdf = out_dir / f"vf_curl_grad_variance__{run}__{tag}__{suffix}.pdf"
    if merged_json.exists() and merged_pdf.exists():
        continue
    print(f"{run}\t{tag}\t{expected}")
PY
  )
}

replot_existing() {
  "$PYTHON_BIN" - "${OUT_DIR}" "${PLOT_BASELINE_FULL_ONLY}" <<'PY'
import sys
from pathlib import Path

out_dir = Path(sys.argv[1]).expanduser()
baseline_full_only = str(sys.argv[2]).lower() == "true"

if not out_dir.exists():
    print(f"[WARN] OUT_DIR not found: {out_dir}")
    sys.exit(0)

eval_root = Path.cwd()
if str(eval_root) not in sys.path:
    sys.path.insert(0, str(eval_root))

from tools.vi_curl_plot.vf_curl_grad_variance import plot_results, _read_json  # type: ignore

paths = sorted(out_dir.glob("vf_curl_grad_variance__*.json"))
count = 0
for p in paths:
    name = p.name
    if "__part" in name or name.endswith(".partial.json"):
        continue
    payload = _read_json(p)
    steps = payload.get("steps", [])
    rows = payload.get("rows", [])
    base_rows = payload.get("baseline_rows")
    title = payload.get("title", "")
    out_base = p.with_suffix("")
    saved = plot_results(
        steps=steps,
        rows=rows,
        baseline_rows=base_rows,
        out_path=out_base,
        title=title,
        baseline_full_only=baseline_full_only,
    )
    for s in saved:
        print(f"[OK] Replotted: {s}")
    count += 1

if count == 0:
    print(f"[WARN] No merged grad_variance json found under: {out_dir}")
PY
}

if [[ "${MERGE_ONLY}" == "true" ]]; then
  echo "[INFO] MERGE_ONLY=true: scan OUT_DIR and merge any complete part sets."
  auto_merge_parts_in_out_dir
  exit 0
fi

if [[ "${REPLOT_ONLY}" == "true" ]]; then
  echo "[INFO] REPLOT_ONLY=true: replot from existing json in OUT_DIR."
  auto_merge_parts_in_out_dir
  replot_existing
  exit 0
fi

is_run_dir() {
  local d="$1"
  compgen -G "${d}/global_step_*" >/dev/null 2>&1
}

baseline_for_run() {
  local run_root="$1"
  local run_name="$2"
  if [[ "${BASELINE_MODE}" != "auto" ]]; then
    return 0
  fi
  # Only pair for "*_curl_*" runs
  if [[ "${run_name}" == *"_curl_"* ]]; then
    local base_name="${run_name/_curl_/_nocurl_}"
    local base_path="${run_root}/${base_name}"
    if [[ -d "${base_path}" ]]; then
      echo "${base_path}"
    fi
  fi
}

run_one() {
  local run_dir="$1"
  local run_root="$2"
  local run_name
  run_name="$(basename "${run_dir}")"

  local baseline_dir=""
  if [[ "${BASELINE_MODE}" == "auto" ]]; then
    baseline_dir="$(baseline_for_run "${run_root}" "${run_name}" || true)"
  fi

  local args=(
    --run_dir "${run_dir}"
    --prompt_file "${PROMPT_FILE}"
    --prompt_field "${PROMPT_FIELD}"
    --prompt_type "${PROMPT_TYPE}"
    --num_prompts "${NUM_PROMPTS}"
    --num_prompt_ratio "${NUM_PROMPT_RATIO}"
    --max_prompt_len "${MAX_PROMPT_LEN}"
    --subset_mode "${SUBSET_MODE}"
    --seed "${SEED}"
    --k_rollouts "${K_ROLLOUTS}"
    --max_new_tokens "${MAX_TOKENS}"
    --temperature "${TEMPERATURE}"
    --top_p "${TOP_P}"
    --sampling_mode "${SAMPLING_MODE}"
    --prob_mode "${PROB_MODE}"
    --gen_batch_size "${GEN_BATCH_SIZE}"
    --shard_load_workers "${SHARD_LOAD_WORKERS}"
    --proj_dim "${PROJ_DIM}"
    --topk "${TOPK}"
    --confidence_metric "${CONF_METRIC}"
    --start_beta "${START_BETA}"
    --end_beta "${END_BETA}"
    --schedule_steps "${SCHEDULE_STEPS}"
    --beta_schedule_mode "${BETA_SCHEDULE_MODE}"
    --beta_source "${BETA_SOURCE}"
    --out_dir "${OUT_DIR}"
  )

  if [[ -n "${BETA_REF_STEPS}" ]]; then
    args+=( --beta_ref_steps "${BETA_REF_STEPS}" )
  fi
  if [[ -n "${BETA_LOG_PATH}" ]]; then
    args+=( --beta_log_path "${BETA_LOG_PATH}" )
  fi
  if [[ "${COMPUTE_PASSK}" == "true" ]]; then
    args+=( --compute_passk --data_name "${DATA_NAME}" --answer_field "${ANSWER_FIELD}" --passk_ks "${PASSK_KS}" )
  fi
  if [[ -n "${BETA_LOG_ROOT}" ]]; then
    args+=( --beta_log_root "${BETA_LOG_ROOT}" )
  fi
  if [[ "${USE_LOG_TAU}" != "true" ]]; then
    args+=( --no_use_log_tau )
  fi
  if [[ -n "${TOKENIZER_DIR}" ]]; then
    args+=( --tokenizer_dir "${TOKENIZER_DIR}" )
  fi

  if [[ "${EMPTY_CACHE_EACH_BATCH}" == "true" ]]; then
    args+=( --empty_cache_each_batch )
  fi
  if [[ "${INFERENCE_MODE}" == "false" ]]; then
    args+=( --no_inference_mode )
  else
    args+=( --inference_mode )
  fi
  if [[ "${ENABLE_TF32}" == "false" ]]; then
    args+=( --no_enable_tf32 )
  else
    args+=( --enable_tf32 )
  fi

  if [[ "${USE_VLLM}" == "false" ]]; then
    args+=( --no_use_vllm )
  else
    export VLLM_USE_FLASHINFER_SAMPLER=1
    args+=( --use_vllm --hf_export_root "${HF_EXPORT_ROOT}" )
    if [[ "${KEEP_HF_EXPORT}" == "true" ]]; then
      args+=( --keep_hf_export )
    fi
    if [[ -n "${BASE_MODEL_DIR}" ]]; then
      args+=( --base_model_dir "${BASE_MODEL_DIR}" )
    fi
    if [[ "${EXPORT_HF_IF_NEEDED}" == "false" ]]; then
      args+=( --no_export_hf_if_needed )
    else
      args+=( --export_hf_if_needed )
    fi
    args+=( --vllm_tensor_parallel_size "${VLLM_TP}" )
    args+=( --vllm_pipeline_parallel_size "${VLLM_PP}" )
    args+=( --vllm_gpu_memory_utilization "${VLLM_GPU_MEM_UTIL}" )
    args+=( --vllm_max_num_seqs "${VLLM_MAX_NUM_SEQS}" )
  fi

  if [[ -n "${STEPS}" ]]; then
    args+=( --steps "${STEPS}" )
  fi
  if [[ -n "${BATCH_VAR_SEEDS}" ]]; then
    args+=( --batch_var_seeds "${BATCH_VAR_SEEDS}" --batch_var_num_prompts "${BATCH_VAR_NUM_PROMPTS}" --batch_var_k "${BATCH_VAR_K}" )
  fi
  if [[ -n "${baseline_dir}" ]]; then
    args+=( --baseline_run_dir "${baseline_dir}" )
  fi
  if [[ -n "${TAG:-}" ]]; then
    args+=( --tag "${TAG}" )
  fi
  if [[ -n "${PART_ID:-}" ]] && [[ -n "${NUM_PARTS:-}" ]] && (( NUM_PARTS > 1 )); then
    args+=( --part_id "${PART_ID}" --num_parts "${NUM_PARTS}" )
    if [[ "${NO_PLOT_PARTS:-false}" == "true" ]]; then
      args+=( --no_plot )
    fi
  fi
  if [[ "${PLOT_BASELINE_FULL_ONLY}" == "true" ]]; then
    args+=( --plot_baseline_full_only )
  fi

  echo "[INFO] Run: ${run_name}"
  if [[ -n "${baseline_dir}" ]]; then
    echo "[INFO]   baseline: $(basename "${baseline_dir}")"
  fi

  "$PYTHON_BIN" -u "${EVAL_ROOT}/tools/vi_curl_plot/vf_curl_grad_variance.py" "${args[@]}"
}

MODEL_ROOTS=()
if compgen -G "${MODEL_ROOT}" >/dev/null 2>&1; then
  while IFS= read -r p; do
    [[ -n "${p}" ]] && MODEL_ROOTS+=("${p}")
  done < <(compgen -G "${MODEL_ROOT}")
else
  MODEL_ROOTS=("${MODEL_ROOT}")
fi

RUN_DIRS=()
RUN_ROOTS=()
add_run_dir() {
  local run_dir="$1"
  local run_root="$2"
  RUN_DIRS+=("${run_dir}")
  RUN_ROOTS+=("${run_root}")
}

for root in "${MODEL_ROOTS[@]}"; do
  if [[ -d "${root}" ]] && is_run_dir "${root}"; then
    add_run_dir "${root}" "$(cd "$(dirname "${root}")" && pwd)"
    continue
  fi
  if [[ -d "${root}" ]]; then
    run_root="$(cd "${root}" && pwd)"
    while IFS= read -r -d '' d; do
      if is_run_dir "${d}"; then
        add_run_dir "${d}" "${run_root}"
      fi
    done < <(find "${run_root}" -maxdepth 1 -mindepth 1 -type d -print0 | sort -z)
  else
    echo "[WARN] MODEL_ROOT entry not found: ${root}"
  fi
done

echo "[INFO] Found ${#RUN_DIRS[@]} runnable dirs."

# -------------------------------------------------------
# Single-run acceleration: shard steps across GPUs
# (similar spirit to run_qwen_eval_all.sge multi-proc)
# -------------------------------------------------------

if (( ${#RUN_DIRS[@]} == 1 )) && (( NUM_GPUS > 1 )); then
  RUN_DIR="${RUN_DIRS[0]}"
  RUN_ROOT="${RUN_ROOTS[0]}"
  RUN_NAME="$(basename "${RUN_DIR}")"

  # Use python to get the exact selected step list (respecting STEPS filter)
  STEP_CSV="$(
    "$PYTHON_BIN" - "${RUN_DIR}" "${STEPS}" <<'PY' | tail -n 1
import re
import sys
from pathlib import Path


def list_steps(run_dir: Path) -> list[int]:
    steps: list[int] = []
    for p in sorted(run_dir.glob("global_step_*")):
        m = re.match(r"^global_step_(\d+)$", p.name)
        if m:
            steps.append(int(m.group(1)))
    steps.sort()
    return steps


def parse_steps_arg(steps_arg: str | None, available: list[int]) -> list[int]:
    if not steps_arg:
        return list(available)

    s = steps_arg.strip()
    if not s:
        return list(available)

    requested: list[int] = []
    for part in [x.strip() for x in s.split(",") if x.strip()]:
        if "-" in part:
            m = re.match(r"^(\d+)-(\d+)(?::(\d+))?$", part)
            if not m:
                raise SystemExit(f"Invalid --steps segment: {part}")
            a = int(m.group(1))
            b = int(m.group(2))
            stride = int(m.group(3) or 1)
            if stride < 1:
                raise SystemExit("Stride in --steps must be >= 1")
            if b >= a:
                requested.extend(list(range(a, b + 1, stride)))
            else:
                requested.extend(list(range(a, b - 1, -stride)))
        else:
            requested.append(int(part))

    avail_set = set(available)
    seen: set[int] = set()
    selected: list[int] = []
    for x in requested:
        if x in avail_set and x not in seen:
            selected.append(x)
            seen.add(x)
    return selected


run_dir = Path(sys.argv[1])
steps_arg = sys.argv[2] if len(sys.argv) > 2 else ""
avail = list_steps(run_dir)
sel = parse_steps_arg(steps_arg if steps_arg else None, avail)
print(",".join(str(x) for x in sel))
PY
  )"

  if [[ -z "${STEP_CSV}" ]]; then
    echo "[WARN] No steps found under ${RUN_DIR}."
    exit 0
  fi

  IFS=',' read -r -a STEP_ARR <<< "${STEP_CSV}"
  echo "[INFO] Selected steps count=${#STEP_ARR[@]} (${STEP_CSV})"
  NPARTS="${NUM_GPUS}"
  if (( ${#STEP_ARR[@]} < NPARTS )); then
    NPARTS="${#STEP_ARR[@]}"
  fi
  if (( NPARTS <= 1 )); then
    echo "[INFO] Only one step shard needed (selected_steps=${#STEP_ARR[@]}, NUM_GPUS=${NUM_GPUS}); continue with single-process mode."
  else
    if [[ "${BETA_SCHEDULE_MODE}" == "rescaled" ]] && [[ -z "${BETA_REF_STEPS}" ]]; then
      # Ensure all parts use a consistent reference step set for beta scheduling.
      BETA_REF_STEPS="${STEP_CSV}"
    fi
    # Use a deterministic tag by default so reruns can resume from *.partial.json / part json files.
    # You can still override by exporting TAG=... before qsub.
    if [[ -z "${TAG:-}" ]]; then
      baseline_dir=""
      if [[ "${BASELINE_MODE}" == "auto" ]]; then
        baseline_dir="$(baseline_for_run "${RUN_ROOT}" "${RUN_NAME}" || true)"
      fi
      TAG="$("$PYTHON_BIN" - "${RUN_DIR}" "${baseline_dir}" "${PROMPT_FILE}" "${PROMPT_FIELD}" "${PROMPT_TYPE}" "${NUM_PROMPTS}" "${NUM_PROMPT_RATIO}" "${MAX_PROMPT_LEN}" "${SUBSET_MODE}" "${SEED}" "${K_ROLLOUTS}" "${MAX_TOKENS}" "${TEMPERATURE}" "${TOP_P}" "${SAMPLING_MODE}" "${PROB_MODE}" "${GEN_BATCH_SIZE}" "${PROJ_DIM}" "${TOPK}" "${CONF_METRIC}" "${TOKENIZER_DIR}" "${START_BETA}" "${END_BETA}" "${SCHEDULE_STEPS}" "${BETA_SCHEDULE_MODE}" "${BETA_REF_STEPS}" "${BETA_SOURCE}" "${BETA_LOG_PATH}" "${BETA_LOG_ROOT}" "${USE_LOG_TAU}" "${BATCH_VAR_SEEDS}" "${BATCH_VAR_NUM_PROMPTS}" "${BATCH_VAR_K}" "${STEP_CSV}" "${USE_VLLM}" "${SHARD_LOAD_WORKERS}" "${EMPTY_CACHE_EACH_BATCH}" "${INFERENCE_MODE}" "${ENABLE_TF32}" "${HF_EXPORT_ROOT}" "${KEEP_HF_EXPORT}" "${VLLM_TP}" "${VLLM_PP}" "${VLLM_GPU_MEM_UTIL}" "${VLLM_MAX_NUM_SEQS}" <<'PY'
import hashlib, json, sys
keys = [
  'run_dir','baseline_dir','prompt_file','prompt_field','prompt_type',
  'num_prompts','num_prompt_ratio','max_prompt_len','subset_mode','seed','k_rollouts','max_new_tokens','temperature','top_p','sampling_mode','prob_mode','gen_batch_size',
  'proj_dim','topk','conf_metric','tokenizer_dir','start_beta','end_beta','schedule_steps',
  'beta_schedule_mode','beta_ref_steps','beta_source','beta_log_path','beta_log_root','use_log_tau',
  'batch_var_seeds','batch_var_num_prompts','batch_var_k','steps',
  'use_vllm','shard_load_workers','empty_cache_each_batch','inference_mode','enable_tf32','hf_export_root',
  'keep_hf_export','vllm_tp','vllm_pp','vllm_gpu_mem_util','vllm_max_num_seqs'
]
vals = sys.argv[1:]
obj = {k: v for k, v in zip(keys, vals)}
beta_mode = (obj.get("beta_schedule_mode") or "").strip()
beta_ref = (obj.get("beta_ref_steps") or "").strip()
beta_source = (obj.get("beta_source") or "compute").strip().lower()
beta_log_path = (obj.get("beta_log_path") or "").strip()
beta_log_root = (obj.get("beta_log_root") or "").strip()
if beta_mode in ("", "train") and beta_ref == "":
  obj.pop("beta_schedule_mode", None)
  obj.pop("beta_ref_steps", None)
if beta_source in ("compute", "") and beta_log_path == "" and beta_log_root == "":
  obj.pop("beta_source", None)
  obj.pop("beta_log_path", None)
  obj.pop("beta_log_root", None)
  obj.pop("use_log_tau", None)
for k in ['num_prompts','max_prompt_len','seed','k_rollouts','max_new_tokens','gen_batch_size','proj_dim','topk','schedule_steps','batch_var_num_prompts','batch_var_k']:
  try:
    obj[k] = int(obj[k])
  except Exception:
    pass
for k in ['num_prompt_ratio','temperature','top_p','start_beta','end_beta']:
  try:
    obj[k] = float(obj[k])
  except Exception:
    pass
s = json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(',',':'))
h = hashlib.sha1(s.encode('utf-8')).hexdigest()[:12]
print(f"auto_{h}")
PY
)"
    fi
    maybe_suffix_tag_for_beta_mode
    NO_PLOT_PARTS="${NO_PLOT_PARTS:-true}"

    echo "[INFO] Single-run step sharding enabled: run=${RUN_NAME} steps=${#STEP_ARR[@]} parts=${NPARTS} tag=${TAG}"

    pids=()
    for ((i=0; i<NPARTS; i++)); do
      part_steps=()
      for ((j=i; j<${#STEP_ARR[@]}; j+=NPARTS)); do
        part_steps+=("${STEP_ARR[j]}")
      done
      PART_STEPS_CSV="$(IFS=,; echo "${part_steps[*]}")"

      LOG_FILE="${LOG_DIR}/vi_curl_grad_variance.${TS}.${RUN_NAME}.part${i}_of_${NPARTS}.gpu${i}.log"
      echo "[INFO] Launch part ${i}/${NPARTS} on GPU ${i}: steps=${PART_STEPS_CSV} Log: ${LOG_FILE}"

      (
        export CUDA_VISIBLE_DEVICES="${i}"
        export PART_ID="${i}"
        export NUM_PARTS="${NPARTS}"
        export STEPS="${PART_STEPS_CSV}"
        run_one "${RUN_DIR}" "${RUN_ROOT}"
      ) > "${LOG_FILE}" 2>&1 &

      pids+=($!)
      sleep 2
    done

    echo "[INFO] All parts started. Waiting for completion..."
    wait || true

    merge_one_parts "${RUN_NAME}" "${TAG}" "${NPARTS}"

    # Also merge any other complete part sets lying around (optional).
    auto_merge_parts_in_out_dir

    echo "[INFO] Done at $(date). Outputs under: ${OUT_DIR}"
    exit 0
  fi
fi

# -------------------------------------------------------
# Execute (parallelized across GPUs, up to NUM_GPUS workers)
# -------------------------------------------------------

pids=()
gpu=0

for idx in "${!RUN_DIRS[@]}"; do
  run_dir="${RUN_DIRS[$idx]}"
  run_root="${RUN_ROOTS[$idx]}"
  run_name="$(basename "${run_dir}")"
  LOG_FILE="${LOG_DIR}/vi_curl_grad_variance.${TS}.${run_name}.gpu${gpu}.log"
  echo "[INFO] Launch: ${run_name} on GPU ${gpu}. Log: ${LOG_FILE}"

  (
    export CUDA_VISIBLE_DEVICES="${gpu}"
    run_one "${run_dir}" "${run_root}"
  ) > "${LOG_FILE}" 2>&1 &

  pids+=($!)
  gpu=$(( (gpu + 1) % NUM_GPUS ))

  # throttle
  while (( $(jobs -rp | wc -l) >= NUM_GPUS )); do
    if wait -n 2>/dev/null; then
      true
    else
      # bash without wait -n: fallback to waiting first pid
      wait "${pids[0]}" || true
      pids=("${pids[@]:1}")
    fi
  done
  sleep 2
done

echo "[INFO] All workers started. Waiting for completion..."
wait || true

# Merge any complete part sets produced by step-sharded runs (or previous partial jobs).
auto_merge_parts_in_out_dir

echo "[INFO] Done at $(date). Outputs under: ${OUT_DIR}"
